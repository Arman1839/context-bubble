# ==============================================================================
# Context Bubble - Backend Environment Variables
# ==============================================================================

# --- Server & Core Configuration ---
ENVIRONMENT=production
PORT=8080
HOST=0.0.0.0
CORS_ORIGINS=["*"]

# --- Firebase & Google Cloud ---
# Your Firebase Project ID
GOOGLE_CLOUD_PROJECT=context-bubble-81904
GCS_BUCKET_NAME=context-bubble-81904.firebasestorage.app

# Firebase Service Account Credentials (choose ONE of the two methods):
# Option A (File Mount, e.g. Render Secret File mounted at /etc/secrets/serviceAccountKey.json):
# GOOGLE_APPLICATION_CREDENTIALS=/etc/secrets/serviceAccountKey.json
# Option B (Inline JSON String - paste entire serviceAccountKey.json content or base64):
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# --- AI & LLM Settings ---
LLM_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001

# Optional Anthropic Claude API Key (if LLM_PROVIDER=anthropic)
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Real-Time Streaming & Scaling (Optional) ---
# Cloud Redis URL (e.g. Upstash, Redis Cloud) for multi-worker SSE synchronization
# REDIS_URL=redis://default:...

# --- Media & Attachments (Optional) ---
# Cloudinary credentials for chat file uploads and document indexing
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# --- Audio Transcription (Optional) ---
# AssemblyAI API Key for voice note transcription
# ASSEMBLYAI_API_KEY=

# --- Security & Rate Limiting ---
FIREBASE_APP_CHECK_ENFORCE=false
SERVER_INTERNAL_SECRET=change-this-to-a-secure-random-secret
BUBBLE_MAX_PARTICIPANTS=10
BUBBLE_DEFAULT_TOKEN_BUDGET=250000
DEBOUNCE_TRAILING_SECONDS=3.0
DEBOUNCE_MAX_WAIT_SECONDS=10.0
RATE_LIMIT_PER_USER_RPM=30
AI_QUIET_PERIOD_SECONDS=2.5
