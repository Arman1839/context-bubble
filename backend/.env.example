# Server Environment
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Firebase & Google Cloud Project
GOOGLE_CLOUD_PROJECT=context-bubble-dev
FIRESTORE_EMULATOR_HOST=localhost:8080
FIREBASE_STORAGE_EMULATOR_HOST=localhost:9199
FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
GCS_BUCKET_NAME=context-bubble-artifacts
CLOUD_TASKS_QUEUE_PATH=projects/context-bubble-dev/locations/us-central1/queues/bubble-timers

# LLM Selection & Keys
LLM_PROVIDER=gemini
# Gemini configuration
GEMINI_API_KEY=AIzaSyFakeKeyForLocalDev
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# Anthropic configuration
ANTHROPIC_API_KEY=sk-ant-fake-key
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Security & App Check
FIREBASE_APP_CHECK_ENFORCE=false
SERVER_INTERNAL_SECRET=dev-internal-secret-for-cloud-tasks-and-schedulers

# Bubble Defaults
BUBBLE_MAX_PARTICIPANTS=10
BUBBLE_DEFAULT_TOKEN_BUDGET=250000
DEBOUNCE_TRAILING_SECONDS=3.0
DEBOUNCE_MAX_WAIT_SECONDS=10.0
RATE_LIMIT_PER_USER_RPM=30
