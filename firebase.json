{
  "firestore": {
    "rules": "backend/firestore.rules",
    "indexes": "backend/firestore.indexes.json"
  },
  "hosting": {
    "public": "out",
    "cleanUrls": true,
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/bubble/create",
        "destination": "/bubble/create.html"
      },
      {
        "source": "/bubble/:id/end",
        "destination": "/bubble/demo/end.html"
      },
      {
        "source": "/bubble/:id",
        "destination": "/bubble/demo.html"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
